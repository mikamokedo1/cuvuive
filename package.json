{
  "name": "frontend-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack & npx tsx server/voice-relay.ts & wait",
    "dev:next": "next dev --webpack",
    "build": "NODE_OPTIONS='--max-old-space-size=6144' next build --webpack",
    "build:relay": "npx esbuild server/voice-relay.ts --bundle --platform=node --target=node20 --outfile=.next/standalone/voice-relay.js --external:bufferutil --external:utf-8-validate",
    "build:all": "npm run build && npm run build:relay",
    "start": "next start",
    "lint": "eslint",
    "db:generate-seed": "npx tsx src/db/generate-seed.ts",
    "db:seed": "npx tsx src/db/seed.ts",
    "send-test-email": "npx tsx scripts/send-test-email.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "voice-relay": "npx tsx server/voice-relay.ts"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "@next/third-parties": "^16.1.6",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.91.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "formik": "^2.4.9",
    "framer-motion": "^12.35.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "matter-js": "^0.20.0",
    "next": "16.1.4",
    "next-mdx-remote": "^6.0.0",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "ws": "^8.21.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dotenv": "^6.1.1",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "googleapis": "^171.4.0",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tumblr.js": "^5.0.1",
    "twitter-api-v2": "^1.29.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
